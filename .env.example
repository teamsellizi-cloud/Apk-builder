# ==============================================================================
# devs APK Builder - Environment Configuration Template (.env.example)
# ==============================================================================

# 1. Database (Supabase / PostgreSQL)
# Get from Supabase Dashboard -> Project Settings -> Database -> Connection URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. Supabase Storage (Optional - falls back to secure server storage)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Authentication & Admin Login
JWT_SECRET=your-random-32-character-secret-key-here
ADMIN_EMAIL=developer@apkbuilder.dev
ADMIN_PASSWORD=your_secure_password_here

# 4. APK Expiring Download Links (HMAC SHA-256)
DOWNLOAD_SIGNING_SECRET=your-download-signing-key-here

# 5. GitHub Actions Runner (Free Tier Cloud Android SDK / Gradle Runner)
# Generate token at https://github.com/settings/tokens with 'repo' and 'workflow' permissions
APP_GITHUB_TOKEN=ghp_your_github_personal_access_token
APP_GITHUB_REPO=yourusername/apk-builder
